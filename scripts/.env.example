# Copy to scripts/.env and fill in. scripts/.env is git-ignored — never commit a funded seed.
# Used by scripts/integration_test.py

# Mnemonic of a funded test wallet. Needed only with --reset, which imports it.
YKADA_SEED="word1 word2 ... word24"

# Testnet address of that wallet. Needed only with --reset: it wipes the YubiKey only when no
# PIV slot holds a key, or when 9c and 9d alone hold keys and they are this wallet.
YKADA_ADDRESS=addr_test1...

# Network to test against: preview | preprod
YKADA_NETWORK=preview

# Optional: recipient address (defaults to the wallet's own address — sustainable for repeats)
# YKADA_RECIPIENT=addr_test1...

# Optional: amount to send, in lovelace (default 1500000 = 1.5 ADA)
# YKADA_AMOUNT=1500000

# Optional: path to a prebuilt ykada binary (default: build release from source)
# YKADA_BIN=target/release/ykada
